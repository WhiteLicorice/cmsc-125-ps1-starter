# The shell scripts run under bash on every platform, so they stay LF.
run text eol=lf
check.sh text eol=lf

# The runner compares the schedule and the metrics. A CRLF checkout on Windows
# would make every expectation disagree with a program that writes LF.
*.work text eol=lf
*.args text eol=lf
*.expect text eol=lf

# GitHub reports the repository's language from the byte count of each source
# language. The checker and the shell entry points are not C, so hide them from
# that count and leave the C sources and the header detectable.
#
# The checker.
*.py linguist-detectable=false
# The test entry points.
*.sh linguist-detectable=false
/run linguist-detectable=false
